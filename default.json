{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for every justanotherspy repository. Extend it with `local>justanotherspy/renovate`.",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeCrate",
    "security:minimumReleaseAgePypi",
    "security:gomodIndirectSecurityUpdates",
    "customManagers:githubActionsVersions",
    "customManagers:makefileVersions",
    "customManagers:dockerfileVersions"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)\\.github/requirements/[^/]+\\.txt$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group all non-major (minor + patch) updates into a single PR and automerge once CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      "description": "Automerge digest and pin updates (e.g. SHA-pinned GitHub Actions and Docker image digests)",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "automerge": true
    },
    {
      "description": "Major updates get their own PR, are never automerged, and are labelled so breaking changes get a human look",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major"
      ]
    }
  ]
}
