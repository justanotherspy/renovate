{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group all non-major (minor + patch) updates into a single PR and automerge once CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      "description": "Automerge digest and pin updates (e.g. SHA-pinned GitHub Actions and Docker image digests)",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "pin"
      ],
      "automerge": true
    }
  ]
}
